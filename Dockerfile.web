FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/app.py ./backend/

# Copy frontend files
COPY frontend/ ./frontend/

# Expose port
EXPOSE 5000

# Run the web app
CMD ["python", "backend/app.py"]
