# ============================================================
# SENTIENT PLATFORM — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── AWS Core ───────────────────────────────────────────────
# Your existing credentials — used in local dev only.
# In production, use IAM roles (no keys needed).
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_REGION=ap-south-1

# ─── SageMaker ──────────────────────────────────────────────
SAGEMAKER_ENDPOINT_NAME=customer-sentiment-analysis-mlops-endpoint
SAGEMAKER_ROLE_ARN=<arn:aws:iam::ACCOUNT_ID:role/SageMakerExecutionRole>

# ─── S3 ─────────────────────────────────────────────────────
S3_BUCKET=<your-s3-bucket-name>
S3_PROJECT_PREFIX=customer-sentiment-analysis-mlops

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentient:sentient_dev@localhost:5432/sentient_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_URL=redis://localhost:6379/1

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=<generate-with: openssl rand -hex 32>
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
API_RATE_LIMIT_PER_MINUTE=60

# ─── JWT Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=<generate-with: openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Logging / Observability ────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=<your-sentry-dsn-or-leave-empty>

# ─── AWS Secrets Manager (Production only) ──────────────────
# Set APP_ENV=production to load secrets from AWS Secrets Manager instead
AWS_SECRETS_MANAGER_SECRET_NAME=sentient/production/secrets

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Sentient Intelligence Platform

# ─── Multi-Tenancy ──────────────────────────────────────────
DEFAULT_TENANT_SLUG=default
MAX_TENANTS=100
